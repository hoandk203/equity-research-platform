# Copy to apps/api/.env (or let `nx run db:install` generate it). Never commit real values.
# The API only starts as ERP_APP/ERP_DESIGN_V1 (or ERP_TEST_APP/ERP_IMPORT_TEST for tests).
ORACLE_CONNECT_STRING=127.0.0.1:1521/FREEPDB1
ORACLE_USER=ERP_APP
ORACLE_SCHEMA=ERP_DESIGN_V1
ORACLE_PASSWORD=
PORT=4000
CORS_ORIGIN=http://localhost:3000
SWAGGER=true
